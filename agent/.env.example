# 配信用PCの agent/.env にコピーして値を入れる。このファイル（.env）は共有・コミットしない。
# 入札サーバーの /agent の URL（外向きに接続する。配信用PCのポートは開けない）
AGENT_SERVER_URL=wss://<PoC サーバーのドメイン>/agent
# data/tokens.json の "agent" の値
AGENT_TOKEN=
# OBS の「ツール → WebSocket サーバー設定」の値。パスワードはこのPCの中だけに置く
OBS_URL=ws://127.0.0.1:4455
OBS_PASSWORD=
# 進行コンソールで切り替えるカメラ: OBS のシーンのうち、名前がこの言葉で始まるもの（省略すると「カメラ」）
# AGENT_CAMERA_PREFIX=カメラ
