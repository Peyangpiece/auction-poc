// Cloudflare で動かすための設定（https://<名前>.<アカウント>.workers.dev で開ける）。手順は docs/03 の 32 章。
{
  "name": "reiwa-no-seri",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  // 会社のドメインのサブドメインでも開けるようにする（DNS の設定は、配るときに Cloudflare が自動で作る）
  "routes": [{ "pattern": "seri.news3r.co.jp", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": {
    // 1 = お試し用（認証番号を画面に出す。今日の開催を自動で作る）。本番の運用では使わない
    "DEMO": "1",
    // コンテナの大きさ（lite / standard-1 〜 standard-4）
    "INSTANCE_TYPE": "standard-1"
  },
  // データの保存先（消えない）。会員・開催・落札・請求書が入る
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "reiwa-no-seri-data" }],
  "containers": [
    {
      "class_name": "AuctionApp",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "./Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "AUCTION_APP", "class_name": "AuctionApp" }]
  },
  "exports": {
    "AuctionApp": { "type": "durable-object", "storage": "sqlite" }
  }
}
