{
  "name": "auction-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "seed": "node tools/seed.js",
    "start": "node server/src/index.js",
    "test": "node --test --test-concurrency=1 \"server/test/*.test.js\"",
    "load": "node tools/load.js",
    "aggregate": "node tools/aggregate.js",
    "test:e2e": "node tools/e2e/walkthrough.mjs && node tools/e2e/members.mjs && node tools/e2e/effects.mjs",
    "create-admin": "node tools/create-admin.js",
    "setup": "node tools/setup-first.js",
    "demo": "node tools/setup-first.js --with-event && POC_DEV_SHOW_CODES=1 POC_TRUST_PROXY=1 POC_IVS_MODE=always-live node server/src/index.js",
    "test:ux": "node tools/e2e/measure.mjs",
    "test:a11y": "node tools/e2e/a11y.mjs",
    "backup": "node tools/backup.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "exceljs": "^4.4.0",
    "jp-zipcode-lookup": "^0.3.5",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "ws": "^8.23.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-ivs": "^3.1169.0"
  },
  "devDependencies": {
    "axe-core": "^4.14.1"
  }
}
