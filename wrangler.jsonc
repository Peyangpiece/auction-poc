// Cloudflare で動かすための設定（https://<名前>.<アカウント>.workers.dev で開ける）。手順は docs/03 の 32 章。
{
  "name": "reiwa-no-seri",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "observability": { "enabled": true },
  // 毎日 9:30（日本時間）に、アプリを起こす（期限の知らせを、だれも開かない日にも送る）
  "triggers": { "crons": ["30 0 * * *"] },
  "vars": {
    // 1 = お試し用（認証番号を画面に出す。今日の開催を自動で作る）。既定は 0（本番の設定）。
    // お試し用で配るときは、配る手順（.github/workflows/deploy-cloudflare.yml）が、明示して 1 を渡す（PRODUCTION=1 でないとき）
    "DEMO": "0",
    // 最初の主催者管理者のメールアドレスの、SHA-256（メールアドレスそのものは、ここに書かない）。
    // このメールアドレスで、スタッフのログインの「はじめての方」から進むと、主催者管理者として登録される（1回だけ）
    "ADMIN_EMAIL_SHA256": "cc5e21db7b08a48f753be0b9470503c9f8c48fffd0aa5553e71fab107ad1817d",
    // コンテナの大きさ（lite / standard-1 〜 standard-4）
    "INSTANCE_TYPE": "standard-1"
  },
  // データの保存先（消えない）。会員・開催・落札・請求書が入る
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "reiwa-no-seri-data" }],
  "containers": [
    {
      "class_name": "AuctionApp",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "./Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "AUCTION_APP", "class_name": "AuctionApp" }]
  },
  "exports": {
    "AuctionApp": { "type": "durable-object", "storage": "sqlite" }
  }
}
