# /etc/auction-poc.env の例（chmod 600）。値は例。秘密の値はここにだけ書く。
PORT=8080
HOST=127.0.0.1
POC_DATA_DIR=/var/lib/auction-poc
# aws: (a) GetStream の問い合わせ と (b) EventBridge の両方で LIVE を判断する
POC_IVS_MODE=aws
AWS_REGION=ap-northeast-1
IVS_CHANNEL_ARN=
IVS_PLAYBACK_URL=
# Lightsail にはインスタンスのロールを付けられない見込み【未検証】のため、ivs:GetStream だけを許した IAM ユーザーのキーを置く
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# EventBridge の API destination が付けてくるヘッダー x-poc-secret の値（乱数で作る）
POC_EVENTBRIDGE_SECRET=
# 障害の模擬を許す（PoC の間だけ 1）
POC_ALLOW_CRASH=1
